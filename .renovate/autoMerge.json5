{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto merge Pre-Commit Hooks",
      matchManagers: ["pre-commit"],
      matchDatasources: ["github-tags"],
      automerge: true,
      ignoreTests: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "Auto-merge all container digest updates (same tag, rebuilt image)",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge container and chart minor and patch updates for standard apps",
      matchDatasources: ["docker", "helm"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        // Media apps
        "/metube/",
        "/pinchflat/",
        "/gallery-dl-server/",
        // AI apps
        "/ollama/",
        "/open-webui/",
        "/litellm/",
        // Home automation apps
        "/home-assistant/",
        "/node-red/",
        "/zwavejs2mqtt/",
        // Productivity apps
        "/bookmarks/",
        "/cyberchef/",
        "/excalidraw/",
        "/it-tools/",
        "/startpunkt/",
        // Radio apps
        "/cloudtak/",
        "/cloudflared/",
        // Infrastructure
        "/goldilocks/",
        "/^ghcr\\.io/actions//",
        "/gha-runner-scale-set/",
        "/clickhouse/",
        "/emqx/",
        "/nodered/",
        // Base images
        "python",
      ],
      ignoreTests: true,
    },
    {
      description: "Auto-merge own (ullbergm) images and charts immediately, no release-age wait",
      matchDatasources: ["docker"],
      matchPackageNames: ["/(^|/)ullbergm//", "startpunkt"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Helm chart minor and patch updates",
      matchManagers: ["helm-values"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions//", "/^renovatebot//"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Python packages",
      matchDatasources: ["pypi"],
      matchManagers: ["pip_requirements"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
  ],
}
