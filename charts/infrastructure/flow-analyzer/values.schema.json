{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Flow Analyzer Helm Chart Values",
  "description": "Configuration values for the Flow Analyzer Helm chart",
  "properties": {
    "cluster": {
      "type": "object",
      "title": "Cluster Configuration",
      "description": "Global cluster configuration inherited from parent chart",
      "properties": {
        "top_level_domain": {
          "type": "string",
          "description": "Top-level domain for the cluster"
        },
        "name": {
          "type": "string",
          "description": "Name of the cluster"
        },
        "admin_email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone for the cluster (e.g., America/New_York)"
        },
        "storage": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "storageClassName": {
                  "type": ["string", "null"],
                  "description": "Storage class for the ClickHouse volume (cluster default if unset)"
                }
              }
            }
          }
        }
      },
      "required": ["top_level_domain", "name", "admin_email", "timezone"]
    },
    "flow-analyzer": {
      "type": "object",
      "title": "Site configuration",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "ip": {
              "type": "string",
              "description": "LAN address (keepalived VIP) the routers send flows to; empty for cluster-internal only"
            },
            "preserveSourceIp": {
              "type": "boolean",
              "description": "Keep the exporter's source address (LoadBalancer + externalTrafficPolicy Local, collector pinned to the keepalived nodes)"
            }
          }
        },
        "allowedExporters": {
          "type": "string",
          "description": "Comma-separated addresses/CIDRs allowed to send flows; empty accepts any"
        },
        "snmp": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "string",
              "description": "Comma-separated address[:port] list to poll; empty disables polling"
            },
            "version": {
              "type": "string",
              "enum": ["2c", "3"]
            },
            "intervalSecs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "internalSubnets": {
          "type": "string",
          "description": "Comma-separated CIDRs treated as internal"
        },
        "dnsServer": {
          "type": "string",
          "description": "Resolver for reverse DNS; empty uses the cluster resolver"
        }
      }
    }
  },
  "required": ["cluster"]
}
