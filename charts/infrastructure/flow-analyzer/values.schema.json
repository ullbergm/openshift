{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Flow Analyzer Helm Chart Values",
  "description": "Configuration values for the Flow Analyzer Helm chart",
  "properties": {
    "cluster": {
      "type": "object",
      "title": "Cluster Configuration",
      "description": "Global cluster configuration inherited from parent chart",
      "properties": {
        "top_level_domain": {
          "type": "string",
          "description": "Top-level domain for the cluster"
        },
        "name": {
          "type": "string",
          "description": "Name of the cluster"
        },
        "admin_email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone for the cluster (e.g., America/New_York)"
        },
        "storage": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "storageClassName": {
                  "type": ["string", "null"],
                  "description": "Storage class for the ClickHouse volume (cluster default if unset)"
                }
              }
            }
          }
        }
      },
      "required": ["top_level_domain", "name", "admin_email", "timezone"]
    },
    "flow-analyzer": {
      "type": "object",
      "title": "Site configuration",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "ip": {
              "type": "string",
              "description": "Static LAN address of the collector's localnet interface; empty for cluster-internal only"
            },
            "prefixLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "physicalNetworkName": {
              "type": "string",
              "description": "OVN bridge mapping name (ovn-bridge-mappings '<name>:br-ex' on every node)"
            },
            "mtu": {
              "type": "integer",
              "minimum": 576
            }
          }
        },
        "allowedExporters": {
          "type": "string",
          "description": "Comma-separated addresses/CIDRs allowed to send flows; empty accepts any"
        },
        "snmp": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "string",
              "description": "Comma-separated address[:port] list to poll; empty disables polling"
            },
            "version": {
              "type": "string",
              "enum": ["2c", "3"]
            },
            "intervalSecs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "internalSubnets": {
          "type": "string",
          "description": "Comma-separated CIDRs treated as internal"
        },
        "knownNetworks": {
          "type": "string",
          "description": "Comma-separated network=kind:name entries (kind router, remote or local) naming parts of the network"
        },
        "dnsServer": {
          "type": "string",
          "description": "Resolver for reverse DNS; empty uses the cluster resolver"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "title": "External Secrets Operator",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Pull the secret from Infisical through the External Secrets Operator; false uses `secrets` instead"
        },
        "data": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "secretKey": {"type": "string"},
                  "remoteKey": {"type": "string"}
                },
                "required": ["secretKey"]
              }
            ]
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "title": "Secrets without the External Secrets Operator",
      "description": "Only used when externalSecret.enabled is false",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Existing Secret with CLICKHOUSE_PASSWORD and, when SNMP polling is on, SNMP_COMMUNITY; empty renders one from the values below"
        },
        "clickhousePassword": {
          "type": "string",
          "description": "ClickHouse password for the flow user; required when existingSecret is empty"
        },
        "snmpCommunity": {
          "type": "string",
          "description": "SNMP community for interface-counter polling"
        }
      }
    }
  },
  "required": ["cluster"]
}
